  "recognition_rules": [
    {
      "rule": "片头识别单元",
      "mvp_rule": "第一有效脚本片段，以及与该脚本片段时间范围重叠的所有分镜。"
    },
    {
      "rule": "第一有效脚本",
      "mvp_rule": "在真实素材边界内按开始时间排序，选择第一段非空、非纯尾帧误切且可解析的脚本片段。"
    },
    {
      "rule": "钩子痛点",
      "mvp_rule": "仍取第一有效脚本片段中的pain_topics，与片头综合类型分别保存。"
    },
    {
      "rule": "多分镜选择",
      "mvp_rule": "先排除无有效画面、转场和装饰素材；优先选择与脚本策略语义匹配的分镜；再按重叠时长最长、开始时间最早决胜。"
    },
    {
      "rule": "脚本多标签",
      "mvp_rule": "将每个二级标签映射到候选片头类型，按照MVP决策优先级输出一个片头综合类型，同时保留全部原始标签。"
    },
    {
      "rule": "分镜覆盖",
      "mvp_rule": "分镜通常用于确认呈现形式和提高置信度；只有演唱前后对比等强视觉证据可以覆盖普通脚本类型。"
    },
    {
      "rule": "脚本缺失",
      "mvp_rule": "使用第一有效分镜进行视觉兜底，并将opening_source_mode标为visual_only。"
    },
    {
      "rule": "画面缺失",
      "mvp_rule": "按脚本策略输出片头类型，opening_source_mode=script_only，置信度最多为中。"
    },
    {
      "rule": "无有效信息",
      "mvp_rule": "脚本与画面均不足时输出其他/无法判断，不根据课程知识库补猜。"
    }
  ],
